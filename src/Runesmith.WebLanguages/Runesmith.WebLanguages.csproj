<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Web Languages for Runesmith: the files, highlighting, comments and brackets of 12 languages.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Runesmith.WebLanguages.Contracts\Runesmith.WebLanguages.Contracts.csproj" />
    <!-- Runesmith supplies the SDK when it loads the plugin, so it is not copied next to it. -->
    <PackageReference Include="Runesmith.Sdk" ExcludeAssets="runtime" />
  </ItemGroup>
  <!-- The TextMate grammars ship as files beside the assembly, where GrammarFiles finds them. -->
  <ItemGroup>
    <None Include="grammars\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
